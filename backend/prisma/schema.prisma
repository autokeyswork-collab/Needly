generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRoleType {
  CUSTOMER
  VENDOR
  RIDER
  MANAGER
  ADMIN
  SUPER_ADMIN

  @@map("Role")
}

enum OrderStatus {
  PLACED
  ACCEPTED
  READY
  PICKED_UP
  DELIVERED
  CANCELLED
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PAID
  REJECTED
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  phone             String?
  locationState     String?            @default("Ogun")
  locationCity      String?            @default("Abeokuta")
  address           String?
  avatarUrl         String?
  passwordHash      String
  role              UserRoleType       @default(CUSTOMER)
  approved          Boolean            @default(true)
  suspendedAt       DateTime?
  expoPushToken     String?
  createdAt         DateTime           @default(now())
  vendor            Vendor?            @relation("VendorOwner")
  managedVendor     Vendor?            @relation("VendorManager")
  rider             Rider?
  orders            Order[]            @relation("CustomerOrders")
  operationalIssues OperationalIssue[]
  reviews           Review[]           @relation("CustomerReviews")
  bookings          Booking[]          @relation("CustomerBookings")
  notifications     Notification[]     @relation("UserNotifications")
  userRoles         UserRole[]
  assignedTickets   SupportTicket[]    @relation("AssignedAdminTickets")
  tickets           SupportTicket[]    @relation("UserSupportTickets")
  securityLogs      SecurityLog[]
}

model Review {
  id           String   @id @default(cuid())
  orderId      String   @unique
  order        Order    @relation(fields: [orderId], references: [id])
  customerId   String
  customer     User     @relation("CustomerReviews", fields: [customerId], references: [id])
  vendorId     String
  vendor       Vendor   @relation(fields: [vendorId], references: [id])
  riderId      String?
  rider        Rider?   @relation(fields: [riderId], references: [id])
  vendorRating Int
  riderRating  Int?
  comment      String?
  createdAt    DateTime @default(now())
}

model Vendor {
  id                String             @id @default(cuid())
  ownerId           String?            @unique
  owner             User?              @relation("VendorOwner", fields: [ownerId], references: [id])
  managerId         String?            @unique
  manager           User?              @relation("VendorManager", fields: [managerId], references: [id])
  name              String
  area              String
  category          String
  eta               String
  rating            Float              @default(4.5)
  emoji             String             @default("🍛")
  isOpen            Boolean            @default(true)
  address           String?
  latitude          Float?
  longitude         Float?
  createdAt         DateTime           @default(now())
  businessRegNumber String?
  ownerIdType       String?
  ownerIdNumber     String?
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  bankAccountLocked Boolean            @default(false)
  bankAccountLockedAt DateTime?
  onboardingFeeAmount Int              @default(2500)
  onboardingFeeStatus String           @default("PENDING")
  onboardingPaymentReference String?   @unique
  onboardingPaidAt   DateTime?
  verified          Boolean            @default(false)
  verifiedAt        DateTime?
  verificationNotes String?
  products          Product[]
  reviews           Review[]
  orders            Order[]
  disputes          Dispute[]
}

model Product {
  id          String         @id @default(cuid())
  vendorId    String
  vendor      Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name        String
  price       Int
  emoji       String         @default("🍽️")
  imageUrl    String?
  subcategory String?
  stock       Int            @default(50)
  isAvailable Boolean        @default(true)
  createdAt   DateTime       @default(now())
  addOns      ProductAddOn[]
}

model ProductAddOn {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  price     Int
}

model Rider {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id])
  zone              String
  isOnline          Boolean   @default(false)
  rating            Float     @default(4.8)
  latitude          Float?
  longitude         Float?
  createdAt         DateTime  @default(now())
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  idType            String?
  idNumber          String?
  verified          Boolean   @default(false)
  verifiedAt        DateTime?
  verificationNotes String?
  orders            Order[]
  reviews           Review[]
  payouts           Payout[]
}

model Payout {
  id          String    @id @default(cuid())
  riderId     String
  rider       Rider     @relation(fields: [riderId], references: [id])
  amount      Int
  status      PayoutStatus @default(PENDING)
  note        String?
  requestedAt DateTime  @default(now())
  processedAt DateTime?
}

model Order {
  id                String             @id @default(cuid())
  customerId        String
  customer          User               @relation("CustomerOrders", fields: [customerId], references: [id])
  vendorId          String
  vendor            Vendor             @relation(fields: [vendorId], references: [id])
  riderId           String?
  rider             Rider?             @relation(fields: [riderId], references: [id])
  status            OrderStatus        @default(PLACED)
  cancelReason      String?
  total             Int
  deliveryAddress   String
  deliveryPhone     String
  deliveryLatitude  Float?
  deliveryLongitude Float?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  items             OrderItem[]
  dispute           Dispute?
  review            Review?
  payment           Payment?
  operationalIssues OperationalIssue[]
}

model OrderItem {
  id      String  @id @default(cuid())
  orderId String
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name    String
  price   Int
  qty     Int
  emoji   String?
}

model Dispute {
  id         String    @id @default(cuid())
  orderId    String    @unique
  order      Order     @relation(fields: [orderId], references: [id])
  vendorId   String
  vendor     Vendor    @relation(fields: [vendorId], references: [id])
  reason     String
  status     DisputeStatus @default(OPEN)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

model OperationalIssue {
  id           String    @id @default(cuid())
  orderId      String?
  order        Order?    @relation(fields: [orderId], references: [id])
  reporterId   String
  reporter     User      @relation(fields: [reporterId], references: [id])
  reporterRole String
  reason       String
  status       String    @default("OPEN")
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String
  actorName   String
  action      String
  targetType  String
  targetId    String?
  targetLabel String
  createdAt   DateTime @default(now())
}

model Payment {
  id                 String    @id @default(cuid())
  orderId            String    @unique
  order              Order     @relation(fields: [orderId], references: [id])
  reference          String    @unique
  amount             Int
  vendorAmount       Int       @default(0)
  platformFeeAmount  Int       @default(0)
  platformFeePercent Float     @default(0)
  deliveryFeeAmount  Int       @default(0)
  deliveryDistanceKm Float?
  gateway            String?
  vendorReceived     Boolean   @default(false)
  vendorReceivedAt   DateTime?
  vendorReceivedById String?
  status             PaymentStatus @default(PENDING)
  createdAt          DateTime  @default(now())
  paidAt             DateTime?
  refundedAt         DateTime?
}

model Service {
  id          String    @id @default(cuid())
  providerId  String
  name        String
  category    String
  price       Int
  description String?
  emoji       String    @default("🛠️")
  isAvailable Boolean   @default(true)
  createdAt   DateTime  @default(now())
  bookings    Booking[]
}

model Booking {
  id           String   @id @default(cuid())
  customerId   String
  customer     User     @relation("CustomerBookings", fields: [customerId], references: [id])
  serviceId    String
  service      Service  @relation(fields: [serviceId], references: [id])
  providerName String
  status       String   @default("PENDING")
  address      String
  phone        String
  total        Int
  scheduledAt  DateTime @default(now())
  cancelReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id])
  title     String
  body      String
  type      String   @default("INFO")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AppRole {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("Role")
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  module          String
  description     String?
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         AppRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Location {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("CITY") // CITY, ZONE, AREA
  parentId    String?
  active      Boolean  @default(true)
  deliveryFee Int      @default(500)
  maxDistance Int      @default(25)
  createdAt   DateTime @default(now())
}

model CommissionRule {
  id          String   @id @default(cuid())
  targetType  String   @default("GLOBAL") // GLOBAL, CATEGORY, VENDOR
  targetId    String?
  targetName  String?
  ratePercent Float    @default(10.0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Promotion {
  id            String    @id @default(cuid())
  code          String    @unique
  title         String
  discountType  String    @default("PERCENT") // PERCENT, FLAT
  discountValue Int
  minSpend      Int       @default(0)
  usageLimit    Int       @default(100)
  timesUsed     Int       @default(0)
  startDate     DateTime  @default(now())
  endDate       DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

model SupportTicket {
  id              String    @id @default(cuid())
  ticketNumber    String    @unique
  userId          String
  user            User      @relation("UserSupportTickets", fields: [userId], references: [id])
  userRole        String    @default("CUSTOMER")
  relatedOrderId  String?
  category        String    @default("GENERAL")
  priority        String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status          String    @default("OPEN") // OPEN, ASSIGNED, WAITING, RESOLVED, CLOSED
  assignedAdminId String?
  assignedAdmin   User?     @relation("AssignedAdminTickets", fields: [assignedAdminId], references: [id])
  subject         String
  description     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Refund {
  id          String    @id @default(cuid())
  paymentId   String?
  orderId     String?
  customerId  String
  amount      Int
  reason      String
  requestedBy String
  approvedBy  String?
  status      String    @default("REQUESTED") // REQUESTED, UNDER_REVIEW, APPROVED, REJECTED, PROCESSING, REFUNDED
  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

model SecurityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  ipAddress String?
  userAgent String?
  event     String
  status    String   @default("SUCCESS") // SUCCESS, FAILED, WARNING
  createdAt DateTime @default(now())
}

model ContactInquiry {
  id         String   @id @default(cuid())
  userId     String?
  name       String
  email      String
  phone      String?
  role       String   @default("GUEST")
  subject    String
  message    String
  status     String   @default("UNREAD")
  replyNote  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ContactConfig {
  id             String   @id @default("default")
  supportPhone   String   @default("+234 800 NEEDLY")
  supportEmail   String   @default("support@needly.market")
  whatsappNumber String   @default("+234 803 123 4567")
  officeAddress  String   @default("Panseke Commercial Hub, Abeokuta, Ogun State")
  operatingHours String   @default("24/7 Everyday")
  updatedAt      DateTime @updatedAt
}

model IntegrationSetting {
  id        String   @id @default(cuid())
  provider  String
  key       String
  value     String
  isSecret  Boolean  @default(true)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, key])
}
