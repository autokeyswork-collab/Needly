# --- Database ---
# Local Postgres example. Create the DB first: `createdb needly_dev`
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/needly_dev?schema=public"

# --- Auth ---
# Any long random string. Generate one with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# --- Paystack ---
# Get test keys from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Server ---
PORT=4000
# Used to build the Paystack checkout callback URL
APP_BASE_URL="http://localhost:4000"

# --- Delivery zone (Phase 1: Abeokuta pilot) ---
ALLOWED_AREAS="Abeokuta,Adigbe,Panseke,Oke-Ilewo,Lafenwa,Kuto,Omida"

# --- Per-delivery rider payout (₦), matches the prototype's flat rate ---
RIDER_PAYOUT_PER_DELIVERY=600

# --- CORS ---
# Comma-separated list of origins allowed to call this API from a browser.
# Native mobile requests (Expo/React Native) don't send an Origin header
# and aren't affected by this — it only matters if you ever add a web client.
ALLOWED_ORIGINS="http://localhost:19006"
